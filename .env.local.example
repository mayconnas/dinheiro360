# ─────────────────────────────────────────────────────────────
# Supabase — pegue em: https://app.supabase.com → seu projeto → Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ─────────────────────────────────────────────────────────────
# Anthropic (Camada 4 — o Cérebro/IA)
# pegue em: https://console.anthropic.com → API Keys
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Modelo do gestor (padrão já é um bom começo)
ANTHROPIC_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# TypeSafe — Jev (opcional): categorização automática na tela de Transações
# pegue em: https://console.typesafe.ai/keys
# Cada usuário também pode salvar a própria chave em Configurações > IA;
# esta é a chave padrão do servidor, usada quando o usuário não tem uma.
# ─────────────────────────────────────────────────────────────
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# ─────────────────────────────────────────────────────────────
# Segurança — cifra as chaves de API que os usuários salvam (AES-256-GCM)
# Gere com: openssl rand -base64 32
# Use o MESMO valor em todo ambiente que aponta para o mesmo banco
# (trocar o valor deixa as chaves já salvas ilegíveis).
# ─────────────────────────────────────────────────────────────
AI_CREDENTIALS_ENCRYPTION_KEY=

# Service role do Supabase (webhook/cron da Pluggy e /api/health) — nunca exponha no client
SUPABASE_SERVICE_ROLE_KEY=

# Logs estruturados: debug | info | warn | error
# LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Open Finance (Pluggy) — https://dashboard.pluggy.ai
# ─────────────────────────────────────────────────────────────
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# URL pública HTTPS do webhook (localhost não funciona) + segredo compartilhado
PLUGGY_WEBHOOK_URL=
PLUGGY_WEBHOOK_SECRET=
# Protege as rotas de sincronização agendada (/api/pluggy/sync e /reprocess)
CRON_SECRET=
