# ─────────────────────────────────────────────────────────────
# Supabase — pegue em: https://app.supabase.com → seu projeto → Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ─────────────────────────────────────────────────────────────
# Anthropic (Camada 4 — o Cérebro/IA)
# pegue em: https://console.anthropic.com → API Keys
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Modelo do gestor (padrão já é um bom começo)
ANTHROPIC_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# TypeSafe — Jev (opcional): categorização automática na tela de Transações
# pegue em: https://console.typesafe.ai/keys
# Cada usuário também pode salvar a própria chave em Configurações > IA;
# esta é a chave padrão do servidor, usada quando o usuário não tem uma.
# ─────────────────────────────────────────────────────────────
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
